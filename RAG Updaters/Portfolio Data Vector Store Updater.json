    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n  item.json.category = $('Loop over Collections').first().json.collection;\n}\n\n// Loop over all input items\nconst results = [];\n\nfor (const item of $input.all()) {\n  // Convert the entire JSON object into a single string\n  const jsonString = JSON.stringify(item.json, null, 2);\n\n  // Keep only the 'chunk' field\n  results.push({ json: { chunk: jsonString } });\n}\n\n// Return the modified list\nreturn results;\n\nreturn $input.all();"
      },
