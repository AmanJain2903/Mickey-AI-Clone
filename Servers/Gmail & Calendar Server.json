    {
      "parameters": {
        "jsonSchemaExample": "{\n\t\"subject\": \"MickeyCloneAI - Requesting Meeting at 6PM Tomorrow.\",\n\t\"body\": \"Hi Aman,\\n\\nI hope you're doing well. This is MickeyCloneAI reaching out to confirm a meeting request for tomorrow at 6 PM.\\n\\nThe purpose of the meeting is to discuss the latest updates on the AI agent’s integration progress, review current challenges, and align on the next development milestones.\\n\\nPlease let me know if this time works for you or if you'd prefer a different slot. Once confirmed, I’ll send a calendar invite with the meeting link.\\n\\nLooking forward to your response.\\n\\nBest regards,\\nMickeyCloneAI\\nAI Development Assistant\"\n}",
        "autoFix": true
